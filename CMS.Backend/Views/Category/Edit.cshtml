@model CMS.Data.Entities.Category

@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0"> <i class="bi bi-pencil-square"></i> CHỈNH SỬA DANH MỤC</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3"> <label class="form-label fw-bold">Tên danh mục:</label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="mb-3"><label class="form-label fw-bold">Mô tả:</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <button type="submit" class="btn btn-warning">Cập nhật thay đổi</button>
                <a asp-action="Index" class="btn btn-secondary"> Hủy bỏ</a>
            </form>
        </div>
   </div>
</div>
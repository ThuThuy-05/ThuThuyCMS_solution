@model CMS.Data.Entities.Customer

@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h5>CHI TIẾT KHÁCH HÀNG</h5>
        </div>

        <div class="card-body">

            <p><strong>ID:</strong> @Model.Id</p>

            <p><strong>Họ tên:</strong> @Model.FullName</p>

            <p><strong>Email:</strong> @Model.Email</p>

            <p><strong>SĐT:</strong> @Model.Phone</p>

            <p><strong>Địa chỉ:</strong> @Model.Address</p>

            <p>
                <strong>Số đơn hàng:</strong>

                @(Model.Orders != null ? Model.Orders.Count : 0)
            </p>

            <a href="/Customers"
               class="btn btn-secondary">
                Quay lại
            </a>

        </div>

    </div>

</div>
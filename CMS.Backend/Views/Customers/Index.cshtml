@model List<CMS.Data.Entities.Customer>

<h2>Danh sách Customers</h2>

<table class="table table-bordered">
    <tr>
        <th>FullName</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Address</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>@item.Phone</td>
            <td>@item.Address</td>
        </tr>
    }
</table>
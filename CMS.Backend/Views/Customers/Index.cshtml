@model List<CMS.Data.Entities.Customer>

<div class="container mt-4">

    <h2 class="text-primary">DANH SÁCH KHÁCH HÀNG</h2>

    <table class="table table-bordered table-hover mt-3">

        <thead class="table-dark">
            <tr>
                <th>Họ tên</th>
                <th>Email</th>
                <th>SĐT</th>
                <th>Địa chỉ</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>
                    <td>
                        <!-- ✅ XEM -->
                        <a href="/Customers/Details/@item.Id"
                           class="btn btn-info btn-sm">
                            Xem
                        </a>
                        <!-- ❌ XÓA -->
                        <a href="/Customers/Delete/@item.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Xóa khách hàng này?')">
                            Xóa
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
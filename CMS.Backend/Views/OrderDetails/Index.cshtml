@{
    Layout = "_LayoutAdmin";
}

@model List<CMS.Data.Entities.OrderDetail>

<h2>Danh sách OrderDetails</h2>

<table class="table table-bordered">
    <tr>
        <th>OrderId</th>
        <th>ProductId</th>
        <th>Quantity</th>
        <th>UnitPrice</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.OrderId</td>
            <td>@item.ProductId</td>
            <td>@item.Quantity</td>
            <td>@item.UnitPrice</td>
        </tr>
    }
</table>
@model CMS.Data.Entities.CategoryProduct

@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"> <i class="bi bi-plus-circle"></i> THÊM DANH MỤC</h4>
        </div>

        <div class="card-body">
           <form asp-action="Create" method="post">
                <div class="mb-3"> <label class="form-label fw-bold">Tên danh mục:</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." />
                </div>

                <div class="mb-3"> <label class="form-label fw-bold">Mô tả:</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả..."></textarea>
                </div>

                <button type="submit" class="btn btn-success"> Lưu</button>

                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </form>
        </div>
    </div>
</div>
@model IEnumerable<CMS.Data.Entities.CategoryProduct>

@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark">QUẢN LÝ DANH MỤC SẢN PHẨM </h2>

        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Thêm danh mục </a>
    </div>

    <table class="table table-hover table-bordered shadow-sm">
        <thead class="table-light">
            <tr>
                <th width="100">Mã</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th width="180">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><strong>@item.Name</strong></td>
                    <td>@(string.IsNullOrEmpty(item.Description) ? "Không có mô tả" : item.Description)</td>
                    <td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">Sửa</a>                    
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm"
                           onclick="return confirm('Bạn chắc chắn muốn xóa?')"> Xóa </a>
                </td>
                </tr>
             }
        </tbody>
    </table>
</div>
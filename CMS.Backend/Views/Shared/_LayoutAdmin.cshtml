<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ThuyCMS Admin</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>

        body {
            background-color: #f5f6fa;
            overflow-x: hidden;
        }

        /* =========================
                   SIDEBAR
                ========================= */

        .sidebar {
            min-height: 100vh;
            background: #212529;
            color: white;
            position: fixed;
            width: 260px;
        }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid #495057;
            text-align: center;
        }

            .sidebar-header h4 {
                margin: 0;
                color: #fff;
                font-weight: bold;
            }

        .sidebar-menu {
            padding-top: 10px;
        }

            .sidebar-menu a {
                color: #ced4da;
                text-decoration: none;
                display: block;
                padding: 12px 20px;
                transition: 0.3s;
                font-size: 15px;
            }

                .sidebar-menu a:hover {
                    background: #343a40;
                    color: white;
                    padding-left: 25px;
                }

            .sidebar-menu i {
                margin-right: 10px;
            }

        /* =========================
                   MAIN CONTENT
                ========================= */

        .main-content {
            margin-left: 260px;
            min-height: 100vh;
        }

        /* =========================
                   TOPBAR
                ========================= */

        .topbar {
            background: white;
            padding: 15px 25px;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .topbar-title {
            font-size: 22px;
            font-weight: bold;
            color: #212529;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-name {
            margin: 0;
            font-size: 15px;
        }

        /* =========================
                   CONTENT
                ========================= */

        .content-wrapper {
            padding: 25px;
        }

        /* =========================
                   CARD STYLE
                ========================= */

        .card {
            border: none;
            border-radius: 12px;
        }

        .table {
            background: white;
        }

    </style>
</head>

<body>

    <div class="sidebar">

        <!-- LOGO -->
        <div class="sidebar-header">
            <h4>
                <i class="bi bi-shield-lock"></i>
                ThuyCMS Admin
            </h4>
        </div>

        <!-- MENU -->
        <div class="sidebar-menu">

            <a asp-controller="Home" asp-action="Index">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>

            <a asp-controller="Category" asp-action="Index">
                <i class="bi bi-grid"></i>
                Quản lý Danh mục
            </a>

            <a asp-controller="Post" asp-action="Index">
                <i class="bi bi-file-earmark-text"></i>
                Quản lý Bài viết
            </a>

            <a asp-controller="User" asp-action="Index">
                <i class="bi bi-person-badge"></i>
                Thành viên hệ thống
            </a>

            <a asp-controller="CategoryProduct" asp-action="Index">
                <i class="bi bi-grid-3x3-gap"></i>
                Danh mục sản phẩm
            </a>

            <a asp-controller="Products" asp-action="Index">
                <i class="bi bi-box-seam"></i>
                Sản phẩm
            </a>

            <a asp-controller="Customers" asp-action="Index">
                <i class="bi bi-people"></i>
                Khách hàng
            </a>

            <a asp-controller="Orders" asp-action="Index">
                <i class="bi bi-receipt"></i>
                Đơn hàng
            </a>

            <a asp-controller="OrderDetails" asp-action="Index">
                <i class="bi bi-cart-check"></i>
                Chi tiết đơn hàng
            </a>

        </div>

    </div>

    <!-- MAIN -->
    <div class="main-content">

        <!-- TOPBAR -->
        <div class="topbar">

            <div class="topbar-title">
                @ViewData["Title"]
            </div>

            <div class="user-info">

                @if (User.Identity.IsAuthenticated)
                {
                    <p class="user-name">
                        <i class="bi bi-person-circle"></i>

                        Xin chào,
                        <strong>
                            @User.FindFirst("FullName")?.Value
                        </strong>

                        (
                        @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                        )
                    </p>

                    <a class="btn btn-outline-danger btn-sm"
                       asp-controller="Account"
                       asp-action="Logout">

                        <i class="bi bi-box-arrow-right"></i>
                        Đăng xuất
                    </a>
                }

            </div>

        </div>

        <!-- CONTENT -->
        <div class="content-wrapper">

            @RenderBody()

        </div>

    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
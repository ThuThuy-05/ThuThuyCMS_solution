@model CMS.Data.Entities.Post

<div class="container mt-4" style="max-width:700px;">

    <h2 class="text-success mb-3">
        THÊM BÀI VIẾT MỚI
    </h2>

    <form asp-action="Create" method="post">

        <input asp-for="Title" class="form-control mb-3" placeholder="Tiêu đề bài viết" />

        <textarea asp-for="Content" class="form-control mb-3" rows="5" placeholder="Nội dung"></textarea>

        <input asp-for="ImageUrl" class="form-control mb-3" placeholder="Hình ảnh" />

        <input asp-for="CreatedDate" type="date" class="form-control mb-3" />

        <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select mb-3">

            <option value="">
                -- Chọn danh mục --
            </option>
        </select>
        <button type="submit" class="btn btn-success">
            Lưu bài viết
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            Hủy
        </a>
    </form>
</div>
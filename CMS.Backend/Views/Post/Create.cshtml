@model CMS.Data.Entities.Post

<div class="container mt-4">

    <h2 class="text-success">
        THÊM BÀI VIẾT MỚI
    </h2>

    <hr />

    <form asp-action="Create" method="post">

        <!-- Tiêu đề -->
        <div class="mb-3">
            <label class="form-label">
                Tiêu đề bài viết
            </label>

            <input asp-for="Title"
                   class="form-control" />
        </div>

        <!-- Nội dung -->
        <div class="mb-3">
            <label class="form-label">
                Nội dung
            </label>

            <textarea asp-for="Content"
                      class="form-control"
                      rows="5"></textarea>
        </div>

        <!-- Hình ảnh -->
        <div class="mb-3">
            <label class="form-label">
                Hình ảnh
            </label>

            <input asp-for="ImageUrl"
                   class="form-control" />
        </div>

        <!-- Ngày đăng -->
        <div class="mb-3">
            <label class="form-label">
                Ngày đăng
            </label>

            <input asp-for="CreatedDate"
                   type="date"
                   class="form-control" />
        </div>

        <!-- Danh mục -->
        <div class="mb-3">

            <label class="form-label">
                Danh mục
            </label>

            <select asp-for="CategoryId"
                    asp-items="ViewBag.CategoryId"
                    class="form-select">

                <option value="">
                    -- Chọn danh mục --
                </option>

            </select>

        </div>

        <!-- Nút -->
        <button type="submit"
                class="btn btn-success">

            Lưu bài viết

        </button>

        <a asp-action="Index"
           class="btn btn-secondary">

            Hủy

        </a>

    </form>

</div>
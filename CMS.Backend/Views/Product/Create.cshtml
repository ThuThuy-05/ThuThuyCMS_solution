@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">

    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">THÊM SẢN PHẨM</h4>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label>Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Mô tả</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                </div>

                <div class="mb-3">
                    <label>Giá</label>
                    <input asp-for="Price" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Tồn kho</label>
                    <input asp-for="StockQuantity" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Hình ảnh</label>
                    <input type="file" name="uploadImage" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Danh mục</label>
                    <select asp-for="CategoryProductId"
                            asp-items="ViewBag.CategoryProductId"
                            class="form-select">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-success">Lưu</button>
                <a href="/Product/Index" class="btn btn-secondary">Hủy</a>
            </form>
        </div>
    </div>
</div>
@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">

    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">CHỈNH SỬA SẢN PHẨM</h4>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label>Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Mô tả</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                </div>

                <div class="mb-3">
                    <label>Giá</label>
                    <input asp-for="Price" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Tồn kho</label>
                    <input asp-for="StockQuantity" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Hình ảnh</label>
                    <input type="file" name="uploadImage" class="form-control" />

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" width="120" class="mt-2" />
                    }
                </div>

                <div class="mb-3">
                    <label>Danh mục</label>
                    <select asp-for="CategoryProductId"
                            asp-items="ViewBag.CategoryProductId"
                            class="form-select">
                    </select>
                </div>

                <button type="submit" class="btn btn-warning">Cập nhật</button>
            </form>
        </div>
    </div>
</div>